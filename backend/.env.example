# ---------------------------------------------------------------------------
# SmartSlide AI backend configuration
# Copy to backend/.env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# AI provider: mock (offline demo mode, no key needed) | claude | gemini
AI_PROVIDER=mock

# Anthropic Claude (https://console.anthropic.com/) - only needed when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Google Gemini (https://aistudio.google.com/) - only needed when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
# Use the offline engine automatically if the AI provider fails (recommended)
AI_FALLBACK_TO_MOCK=true

# Storage (relative paths are resolved from the backend folder)
STORAGE_DIR=storage
# DATABASE_URL=sqlite:///storage/smartslide.db

# Limits
MAX_UPLOAD_MB=25
MAX_PAGES=300
CHUNK_MAX_CHARS=12000
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MAX_PAGES=60

# Automatic deletion of uploads and generated files
FILE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
